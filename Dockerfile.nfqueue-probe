# Isolated lab-only probe; uses the already built diagnostic image.
ARG BASE_IMAGE=mikrotik-zapret2:diagnostic
FROM ${BASE_IMAGE}
RUN apt-get update && apt-get install -y --no-install-recommends python3 \
 && rm -rf /var/lib/apt/lists/*
COPY container/probe_nfqueue.py /usr/local/bin/probe_nfqueue.py
ENTRYPOINT ["python3", "-u", "/usr/local/bin/probe_nfqueue.py"]
